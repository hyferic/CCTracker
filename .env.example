# Browser-safe Supabase project URL from Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Browser-safe only because migrations enforce authenticated RLS and least-privilege grants.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Browser-safe exact deployment root used for PKCE, including trailing slash.
VITE_APP_BASE_URL=http://localhost:5173/
# Optional browser-safe Vite asset base. Pages workflow sets this from the repository name.
VITE_BASE_PATH=/

# The following values are SERVER-ONLY. Do not put them in any VITE_* variable.
# RESEND_API_KEY: Supabase Edge Function secret; benefit-mail sending key.
# RESEND_FROM_EMAIL: Supabase Edge Function secret; verified benefit sender.
# SCHEDULER_SECRET: Supabase Edge secret + Vault + GitHub production secret; >=32 random bytes.
# PROCESS_NOTIFICATIONS_URL: Vault + GitHub variable; function URL (URL itself is non-secret).
# SUPABASE_ACCESS_TOKEN: GitHub production secret; never exposed to the browser.
# SUPABASE_PROJECT_REF: GitHub variable; non-secret project identifier.
# SUPABASE_DB_PASSWORD: GitHub production secret; never exposed to the browser.
